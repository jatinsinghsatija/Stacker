<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
      Note what is NOT here: there is no <activity-alias> for the Stacker
      launcher icon.

      The library ships that alias in its own `debug` source set, so it merges
      into this app automatically. Declaring a second one here caused a
      manifest-merger conflict on `android:label` — which is exactly the error
      a host app would hit if it followed older instructions that told it to
      paste the alias in by hand.

      Build this example in debug and two launcher icons appear: "stacker_example"
      and "Stacker". Build it in release and only the app's own icon remains.
    -->
</manifest>
