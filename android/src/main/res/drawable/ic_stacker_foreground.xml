<?xml version="1.0" encoding="utf-8"?>
<!--
  Stacker launcher icon foreground: three offset layers, largest at the
  bottom, reading as a stack seen in perspective. A magnifier sits on the top
  layer to signal inspection.

  Drawn on the standard 108dp adaptive-icon canvas. The artwork is kept
  inside the middle 66dp safe zone so no launcher mask can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Bottom layer: the widest, darkest plate. -->
    <path
        android:fillColor="#1A3A8F"
        android:pathData="M54,79.5 L26,68.5 L54,57.5 L82,68.5 Z" />

    <!-- Middle layer. -->
    <path
        android:fillColor="#2962FF"
        android:pathData="M54,66 L30,56.5 L54,47 L78,56.5 Z" />

    <!-- Top layer: brightest, carries the magnifier. -->
    <path
        android:fillColor="#5B8DEF"
        android:pathData="M54,52.5 L34,44.5 L54,36.5 L74,44.5 Z" />

    <!-- Magnifier lens over the top plate. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M57,30.5 m-8.5,0 a8.5,8.5 0 1,0 17,0 a8.5,8.5 0 1,0 -17,0 Z" />
    <path
        android:fillColor="#2962FF"
        android:pathData="M57,30.5 m-5.5,0 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0 Z" />
    <!-- Magnifier handle. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M62.8,36.3 L69.5,43 L66.3,46.2 L59.6,39.5 Z" />
</vector>
